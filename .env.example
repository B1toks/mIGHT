# Скопіюй цей файл у .env.local і встав значення зі свого Supabase-проєкту:
# Supabase Dashboard -> Project Settings -> API

# Публічні (попадають у браузерний бандл — це ОК, anon key захищений RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# СЕКРЕТНИЙ ключ — обходить RLS! Тільки для серверних скриптів (seed, admin).
# Ніколи не імпортувати в код, що бандлиться для браузера.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
